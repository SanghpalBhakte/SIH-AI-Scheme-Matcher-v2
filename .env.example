# Supabase — optional. The app works fully offline/without these (see
# lib/supabase/client.ts): if unset, the site runs exactly as it did
# before this integration, on the bundled static scheme data and
# localStorage alone.
#
# NEXT_PUBLIC_* vars are exposed to the browser — that's expected here:
# the anon/publishable key is meant to be public (Supabase's Row Level
# Security policies, not secrecy, are what protect the data behind it).
# Get these from your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key — NEVER prefix this with NEXT_PUBLIC_, never expose
# it to the browser. Only used locally/in CI to run
# `npm run seed:supabase` after editing data/schemes.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
